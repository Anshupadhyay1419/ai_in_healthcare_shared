# Copy to .env (never commit it). Synthetic data only, on any route.
# Your agent must read the model from AGENT_MODEL: the instructor runs the hidden test with their own value.
# Hosted API route:
AGENT_MODEL=google_genai:<model-name>
GOOGLE_API_KEY=<your-key>
# Local route (Ollama running on this machine with the model already pulled):
# AGENT_MODEL=ollama:<installed-model>
